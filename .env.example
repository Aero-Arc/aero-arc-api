# Host port mappings
API_PORT=8080
POSTGRES_PORT=5432

# Local development database credentials
POSTGRES_DB=aero_arc
POSTGRES_USER=aero_arc
POSTGRES_PASSWORD=aero_arc_dev

# Compose uses PostgreSQL/PostGIS as the authoritative deconfliction store.
# Add interuss to the comma-separated list to enable DSS discovery.
AERO_API_AIRSPACE_PROVIDERS=local
AERO_API_DSS_BASE_URL=
AERO_API_DSS_OAUTH_TOKEN_URL=
AERO_API_DSS_ALLOW_INSECURE_PEER_URLS=false
AERO_API_USS_BASE_URL=
AERO_API_USS_JWT_PUBLIC_KEY_FILE=
AERO_API_USS_JWT_ISSUER=
AERO_API_USS_JWT_AUDIENCE=
