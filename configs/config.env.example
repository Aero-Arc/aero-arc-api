# Environment-variable reference for `aero-arc-api start`.
#
# The application does not load YAML configuration files. Export these values
# in the shell or provide them through the process/container environment.

AERO_API_ADDR=:8080
AERO_API_DURABLE_STORE=memory
AERO_API_TELEMETRY_STORE=memory
# Required only when AERO_API_TELEMETRY_STORE=influxdb:
# AERO_API_INFLUXDB_HOST=http://localhost:8181
# AERO_API_INFLUXDB_TOKEN=replace-me
# AERO_API_INFLUXDB_DATABASE=aero_arc
AERO_API_REPLAY_STORE=memory
AERO_API_REGISTRY_MODE=memory
AERO_API_REGISTRY_ADDR=localhost:50051
AERO_API_REGISTRY_DIAL_TIMEOUT=5s
AERO_API_REQUEST_TIMEOUT=3s
# Set to demo for local UI fixtures; leave empty for no seed.
AERO_API_SEED=
AERO_API_DEBUG=false
