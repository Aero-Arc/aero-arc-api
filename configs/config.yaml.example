addr: ":8080"
durable_store: "memory"
telemetry_store: "memory"
# InfluxDB 3 Core telemetry reader (used when telemetry_store is "influxdb"):
# influxdb_host: "http://localhost:8181"
# influxdb_token: "replace-me"
# influxdb_database: "aero_arc"
replay_store: "memory"
registry_mode: "memory" # use "grpc" to connect to aero-arc-registry
registry_addr: "localhost:50051"
seed: "" # set to "demo" for local UI fixture data

# Environment variables used by the service:
# AERO_API_ADDR=:8080
# AERO_API_DURABLE_STORE=memory
# AERO_API_TELEMETRY_STORE=memory
# AERO_API_INFLUXDB_HOST=http://localhost:8181
# AERO_API_INFLUXDB_TOKEN=replace-me
# AERO_API_INFLUXDB_DATABASE=aero_arc
# AERO_API_REPLAY_STORE=memory
# AERO_API_REGISTRY_MODE=memory
# AERO_API_REGISTRY_ADDR=localhost:50051
# AERO_API_SEED=demo
